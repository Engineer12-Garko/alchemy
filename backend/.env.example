APP_ENV=development
DATABASE_URL=sqlite:///./alchemy_local.db
JWT_SECRET=replace-this-before-deployment
JWT_EXPIRE_MINUTES=10080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI-compatible provider (set BASE_URL + API_KEY + MODEL to use OpenAI or a compatible service)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

# Google Gemini provider (alternative to OpenAI — set GEMINI_API_KEY + GEMINI_MODEL)
# Keys starting with "AIza" or "AQ" are detected as Gemini automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MAX_UPLOAD_MB=20
